node_modules/
.DS_Store
*.log
.env
.env.local

# AHOL runtime artifacts (regenerable; not source)
.ahol/
.claude/scheduled_tasks.lock
.claude/settings.local.json
logs/
packages/ahol/__pycache__/
packages/ahol/runner/__pycache__/
ahol-claude-dry-run.ahol-claude-dry-run.json

# GSD per-project runtime state (schema lives in packages/gsd/bin/lib/config.cjs)
.planning/config.json

# internal build planning (not published)
.planning/

# Python bytecode (pytest runs at repo root)
__pycache__/
*.pyc

# Exception: the pre-repair v5.0 test fixture IS a committed .planning/ tree. The rule above
# has no leading slash, so it matches at any depth and silently skips all 25 extracted files
# on `git add` - the suite would pass locally while the fixture never lands in the repo.
!tests/fixtures/**/.planning/
