{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(chmod -R 777 *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "skills": {
    "enabled": [],
    "disabled": [],
    "autoInvoke": {}
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.claude/statusline.py\"",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/gsd-check-update.js\"" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-cerebrum-recall.js\"", "timeout": 5 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-vault-audit-nudge.js\"", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-compact-nudge.js\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-lint-loop.js\"", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/gsd-prompt-guard.js\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-permission-guard.js\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-file-index.js\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-cerebrum-check.js\"", "timeout": 5 }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-precompact-snapshot.js\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-vault-capture.js\"", "timeout": 10 }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-postcompact.js\"", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-vault-capture.js\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-instinct-observe.js\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-green-gate.js\"", "timeout": 20 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/cco-green-gate.js\"", "timeout": 20 }
        ]
      }
    ]
  }
}
