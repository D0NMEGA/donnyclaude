#!/usr/bin/env python3 -I
"""Redact known secret values and token patterns from local Claude Code and Codex logs.

Never prints a secret. Values come from the environment (the names listed below) so the script
never needs to read ~/.zshenv. Token patterns cover Tailscale auth keys and GitHub tokens.
Files are rewritten atomically; a file that is currently being appended to by a live session
should be skipped with --skip <substring> and scrubbed after that session ends.

Usage: cc-scrub-secrets [--dry-run] [--daily] [--skip <substring>]... [extra files...]
"""
import glob
import os
import re
import sqlite3
import sys

HOME = os.path.expanduser("~")
NAMES = ["SEMANTIC_SCHOLAR_API_KEY", "S2_API_KEY", "BRAVE_API_KEY", "YOUTUBE_API_KEY", "NEWSAPI_KEY"]
PATTERNS = {
    "TAILSCALE_KEY": re.compile(r"tskey-(?:auth|client|api)-[A-Za-z0-9-]{10,}"),
    "GITHUB_TOKEN": re.compile(r"(?:ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|gho_[A-Za-z0-9]{20,})"),
}
DEFAULT_FILES = (
    [f"{HOME}/.claude/history.jsonl"]
    + glob.glob(f"{HOME}/.claude/projects/*/*.jsonl")
    + glob.glob(f"{HOME}/.codex/sessions/*/*/*/*.jsonl")
)
SQLITE = f"{HOME}/.codex/thread_history_1.sqlite"


def main(argv):
    dry = "--dry-run" in argv
    if "--daily" in argv:
        # Hook mode: at most one pass per 20 hours; the stamp is touched before the pass.
        import time
        stamp = os.path.join(HOME, ".cache", "cc-scrub-secrets.stamp")
        if os.path.exists(stamp) and time.time() - os.path.getmtime(stamp) < 20 * 3600:
            return 0
        os.makedirs(os.path.dirname(stamp), exist_ok=True)
        open(stamp, "w").close()
    skips = [argv[i + 1] for i, a in enumerate(argv) if a == "--skip" and i + 1 < len(argv)]
    extra = [a for i, a in enumerate(argv) if not a.startswith("--") and (i == 0 or argv[i - 1] != "--skip")]
    values = {n: os.environ.get(n, "") for n in NAMES}
    values = {n: v for n, v in values.items() if len(v) >= 8}
    if not values:
        print("no secret values in the environment; only pattern-based redaction will run")
    files = DEFAULT_FILES + extra
    total = 0
    for f in files:
        if any(s in f for s in skips):
            print(f"skip {f.replace(HOME, '~')}")
            continue
        try:
            s = open(f, encoding="utf-8", errors="surrogateescape").read()
        except OSError:
            continue
        n = 0
        for name, v in values.items():
            c = s.count(v)
            if c:
                s = s.replace(v, f"[REDACTED:{name}]")
                n += c
        for name, p in PATTERNS.items():
            s, c = p.subn(f"[REDACTED:{name}]", s)
            n += c
        if n:
            total += n
            print(f"{f.replace(HOME, '~')}: {n} replacement(s){' (dry run)' if dry else ''}")
            if not dry:
                tmp = f + ".scrub.tmp"
                with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as out:
                    out.write(s)
                os.replace(tmp, f)
    if os.path.exists(SQLITE) and not any(s in SQLITE for s in skips):
        con = sqlite3.connect(SQLITE)
        cur = con.cursor()
        n = 0
        for name, v in values.items():
            hit = cur.execute("select count(*) from thread_items where instr(item_json, ?) > 0", (v,)).fetchone()[0]
            if hit and not dry:
                cur.execute("update thread_items set item_json = replace(item_json, ?, ?) where instr(item_json, ?) > 0",
                            (v, f"[REDACTED:{name}]", v))
            n += hit
        if not dry:
            con.commit()
        con.close()
        if n:
            total += n
            print(f"{SQLITE.replace(HOME, '~')}: {n} row(s){' (dry run)' if dry else ''}")
    print(f"done: {total} replacement(s) across {len(files)} files + sqlite")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
