# Copy to .env (gitignored) and fill in. All keys are OPTIONAL — each source degrades
# gracefully (no_key in the status header) when its key is absent. A real exported env
# var always wins over .env (load_dotenv override=False).
BRAVE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
YOUTUBE_API_KEY=
STACKEXCHANGE_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
GITHUB_TOKEN=
